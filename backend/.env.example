DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/okhovat
REDIS_URL=redis://127.0.0.1:6379/0
TRUST_PROXY_PROTO=False
# Private uploaded files must live on a persistent disk in production.
# Legacy fallback for files uploaded before purpose-specific storage.
# UPLOADS_DIR=/srv/okhovat/private-media
AVATARS_DIR=/data/avatars
POSTS_DIR=/data/posts
SKILLS_DIR=/data/skills
LANDING_DIR=/data/landing
# Optional service-account JSON file, mounted privately (never put in Git):
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
# Optional local language-model classifier; empty means deterministic assistant.
# ASSISTANT_OLLAMA_MODEL=
# ASSISTANT_OLLAMA_URL=http://127.0.0.1:11434

# Set only for a known proxy chain that sanitizes X-Forwarded-For.
TRUSTED_PROXY_COUNT=0
